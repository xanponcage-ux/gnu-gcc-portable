l" value="&quot;(All)&quot;" param-domain-type="list" _.fcp.ParameterDefaultValues.true...source-field="[federated.ldp_filter_values].[ENC_FRT_IND]"><calculation class="tableau" formula="&quot;(All)&quot;"/><members><member value="&quot;(All)&quot;"/></members></column><column caption="SO/DEL Block" name="[Parameter 7]" datatype="string" role="dimension" type="nominal" value="&quot;(All)&quot;" param-domain-type="list"><calculation class="tableau" formula="&quot;(All)&quot;"/><members><member value="&quot;(All)&quot;"/><member value="&quot;OPEN&quot;"/><member value="&quot;BLOCKED&quot;"/></members></column></datasource><datasource caption="LDP Oracle Ten Tables" inline="true" name="federated.ldp_live_v13" version="18.1">
