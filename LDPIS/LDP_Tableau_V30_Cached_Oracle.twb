      <aliases enabled="yes"/>
      <column datatype="real" name="[Column Number]" role="dimension" type="ordinal"/>
      <column datatype="integer" name="[Metric]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Table Number] WHEN 11 THEN CASE [Column Number] WHEN 1 THEN 12 WHEN 2 THEN 16 END WHEN 1 THEN CASE [Column Number] WHEN 1 THEN 1 WHEN 2 THEN 5 WHEN 3 THEN 8 WHEN 4 THEN 12 END WHEN 2 THEN CASE [Column Number] WHEN 1 THEN 2 WHEN 2 THEN 12 WHEN 3 THEN 16 WHEN 4 THEN 19 WHEN 5 THEN 21 END WHEN 3 THEN CASE [Column Number] WHEN 1 THEN 3 WHEN 2 THEN 6 WHEN 3 THEN 9 WHEN 4 THEN 13 WHEN 5 THEN 17 WHEN 6 THEN 20 WHEN 7 THEN 22 WHEN 8 THEN 23 WHEN 9 THEN 24 END WHEN 4 THEN CASE [Column Number] WHEN 1 THEN 1 WHEN 2 THEN 5 END WHEN 5 THEN CASE [Column Number] WHEN 1 THEN 1 WHEN 2 THEN 5 END WHEN 6 THEN CASE [Column Number] WHEN 1 THEN 4 WHEN 2 THEN 7 WHEN 3 THEN 11 WHEN 4 THEN 15 END WHEN 7 THEN CASE [Column Number] WHEN 1 THEN 4 WHEN 2 THEN 7 WHEN 3 THEN 11 WHEN 4 THEN 15 END WHEN 8 THEN CASE [Column Number] WHEN 1 THEN 4 WHEN 2 THEN 7 WHEN 3 THEN 11 WHEN 4 THEN 15 END WHEN 9 THEN CASE [Column Number] WHEN 1 THEN 3 WHEN 2 THEN 6 WHEN 3 THEN 10 WHEN 4 THEN 14 WHEN 5 THEN 18 END WHEN 10 THEN CASE [Column Number] WHEN 1 THEN 3 WHEN 2 THEN 6 WHEN 3 THEN 10 WHEN 4 THEN 14 WHEN 5 THEN 18 END END"/>
        <aliases>
          <alias key="1" value="B2D"/>
          <alias key="2" value="Total Stock"/>
          <alias key="3" value="Signoff Qty"/>
          <alias key="4" value="Below Age"/>
          <alias key="5" value="BTR"/>
          <alias key="6" value="Grn Compliance"/>
          <alias key="7" value="High Age"/>
          <alias key="8" value="Pending Do"/>
          <alias key="9" value="GRN Compliance (%)"/>
          <alias key="10" value="SIGNOFF GRN"/>
          <alias key="11" value="Potential High Age"/>
          <alias key="12" value="Total Linked Stock"/>
          <alias key="13" value="Rolling Osp"/>
          <alias key="14" value="NON SIGNOFF GRN"/>
          <alias key="15" value="Grand Total"/>
          <alias key="16" value="Total Unlink Stock"/>
          <alias key="17" value="Rolling MTD"/>
          <alias key="18" value="GAP"/>
          <alias key="19" value="Hold Batch (MT)"/>
          <alias key="20" value="Rolling Compliance (%)"/>
          <alias key="21" value="Hold Batch (%)"/>
          <alias key="22" value="Production Osp"/>
          <alias key="23" value="Production MTD"/>
          <alias key="24" value="Production Compliance (%)"/>
        </aliases>
      </column>
      <column datatype="real" name="[Row Number]" role="dimension" type="ordinal"/>
      <column datatype="real" name="[Table Number]" role="dimension" type="ordinal"/>
