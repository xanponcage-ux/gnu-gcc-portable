    ABS(FG.VER_EOP_CE_P) AS VER_EOP_CE_P,
    ABS(FG.VER_EOP_CE_T) AS VER_EOP_CE_T,
    ABS(FG.VER_EOP_CE_N) AS VER_EOP_CE_N,
    ABS(FG.VER_EOP_CE_TOTAL) AS VER_EOP_CE_TOTAL,
    ABS(FG.VER_EOP_CS_P) AS VER_EOP_CS_P,
    ABS(FG.VER_EOP_CS_T) AS VER_EOP_CS_T,
    ABS(FG.VER_EOP_CS_N) AS VER_EOP_CS_N,
    ABS(FG.VER_EOP_CS_TOTAL) AS VER_EOP_CS_TOTAL,
    ABS(FG.VER_EOP_EP_P) AS VER_EOP_EP_P,
    ABS(FG.VER_EOP_EP_T) AS VER_EOP_EP_T,
    ABS(FG.VER_EOP_EP_N) AS VER_EOP_EP_N,
    ABS(FG.VER_EOP_EP_TOTAL) AS VER_EOP_EP_TOTAL,
    ABS(FG.VER_EOP_BLANK_P) AS VER_EOP_BLANK_P,
    ABS(FG.VER_EOP_BLANK_T) AS VER_EOP_BLANK_T,
    ABS(FG.VER_EOP_BLANK_N) AS VER_EOP_BLANK_N,
    ABS(FG.VER_EOP_BLANK_TOTAL) AS VER_EOP_BLANK_TOTAL,
        ---
    ABS(PDO.P_DO_BPR_P) AS P_DO_BPR_P,
    ABS(PDO.P_DO_BPR_T) AS P_DO_BPR_T,
    ABS(PDO.P_DO_BPR_N) AS P_DO_BPR_N,
    ABS(PDO.P_DO_BPR_TOTAL) AS P_DO_BPR_TOTAL,
    ABS(PDO.P_DO_CE_P) AS P_DO_CE_P,
    ABS(PDO.P_DO_CE_T) AS P_DO_CE_T,
    ABS(PDO.P_DO_CE_N) AS P_DO_CE_N,
    ABS(PDO.P_DO_CE_TOTAL) AS P_DO_CE_TOTAL,
    ABS(PDO.P_DO_CS_P) AS P_DO_CS_P,
    ABS(PDO.P_DO_CS_T) AS P_DO_CS_T,
    ABS(PDO.P_DO_CS_N) AS P_DO_CS_N,
    ABS(PDO.P_DO_CS_TOTAL) AS P_DO_CS_TOTAL,
    ABS(PDO.P_DO_EP_P) AS P_DO_EP_P,
    ABS(PDO.P_DO_EP_T) AS P_DO_EP_T,
    ABS(PDO.P_DO_EP_N) AS P_DO_EP_N,
    ABS(PDO.P_DO_EP_TOTAL) AS P_DO_EP_TOTAL,
    ABS(PDO.P_DO_BLANK_P) AS P_DO_BLANK_P,
    ABS(PDO.P_DO_BLANK_T) AS P_DO_BLANK_T,
    ABS(PDO.P_DO_BLANK_N) AS P_DO_BLANK_N,
    ABS(PDO.P_DO_BLANK_TOTAL) AS P_DO_BLANK_TOTAL,
        -- Existing OSP values
    ABS(OSP_CS_Q.OSP_CS_VAL) AS OSP_CS,
    ABS(OSP_EP_Q.OSP_EP_VAL) AS OSP_EP,
    ABS(OSP_BPR_Q.OSP_BPR_VAL) AS OSP_BPR,
    ABS(OSP_CE_Q.OSP_CE_VAL) AS OSP_CE,
    ABS(OSP_API_Q.OSP_API_VAL) AS OSP_API,
    ABS(OSP_NORTH_Q.OSP_NORTH_VAL) AS OSP_NORTH,
    ABS(OSP_SOUTH_Q.OSP_SOUTH_VAL) AS OSP_SOUTH,
    ABS(OSP_WEST_Q.OSP_WEST_VAL) AS OSP_WEST,
    ABS(OSP_EXPORT_Q.OSP_EXPORT_VAL) AS OSP_EXPORT,
    ABS(OSP_EAST_Q.OSP_EAST_VAL) AS OSP_EAST,
    -- New MTD_4 values (from user's request)
    ABS(MTD_4_API_Q.MTD_4_API) AS MTD_4_API,
    ABS(MTD_4_EAST_Q.MTD_4_EAST) AS MTD_4_EAST, -- Renamed to avoid ambiguity
    ABS(MTD_4_EXPORT_Q.MTD_4_EXPORT) AS MTD_4_EXPORT,
    ABS(MTD_4_NORTH_Q.MTD_4_NORTH) AS MTD_4_NORTH,
    ABS(MTD_4_SOUTH_Q.MTD_4_SOUTH) AS MTD_4_SOUTH,
    ABS(MTD_4_WEST.MTD_4_WEST) AS  MTD_4_WEST, -- Renamed to avoid ambiguity
    ABS(MTD_4_CS_Q.MTD_4_CS) AS MTD_4_CS,
    ABS(MTD_4_BPR_Q.MTD_4_BPR) AS MTD_4_BPR,
    ABS(MTD_4_ENP_Q.MTD_4_ENP) AS MTD_4_ENP,
    ABS(MTD_4_CE_Q.MTD_4_CE) AS MTD_4_CE,
    -- GAP---- VALUES
    ABS((OSP_CS_Q.OSP_CS_VAL - MTD_4_CS_Q.MTD_4_CS)) OSP_CS_VAL,
    ABS((OSP_EP_Q.OSP_EP_VAL - MTD_4_ENP_Q.MTD_4_ENP)) OSP_EP_VAL,
    ABS((OSP_BPR_Q.OSP_BPR_VAL- MTD_4_BPR_Q.MTD_4_BPR)) OSP_BPR_VAL,
    ABS((OSP_CE_Q.OSP_CE_VAL - MTD_4_CE_Q.MTD_4_CE)) OSP_CE_VAL,
    ABS((OSP_API_Q.OSP_API_VAL - MTD_4_API_Q.MTD_4_API)) OSP_API_VAL,
    ABS((OSP_NORTH_Q.OSP_NORTH_VAL - MTD_4_NORTH_Q.MTD_4_NORTH)) OSP_NORTH_VAL,
    ABS((OSP_SOUTH_Q.OSP_SOUTH_VAL- MTD_4_SOUTH_Q.MTD_4_SOUTH)) OSP_SOUTH_VAL,
    ABS((OSP_WEST_Q.OSP_WEST_VAL - MTD_4_WEST.MTD_4_WEST)) OSP_WEST_VAL,
    ABS((OSP_EXPORT_Q.OSP_EXPORT_VAL - MTD_4_EXPORT_Q.MTD_4_EXPORT)) OSP_EXPORT_VAL,
    ABS((OSP_EAST_Q.OSP_EAST_VAL  - MTD_4_EAST_Q.MTD_4_EAST)) OSP_EAST_VAL,
    -- Added PENDING_DO values
    ABS(PENDING_DO_API_Q.PENDING_DO_API) PENDING_DO_API,
    ABS(PENDING_DO_EXPORT_Q.PENDING_DO_EXPORT) PENDING_DO_EXPORT,
    ABS(PENDING_DO_WEST_Q.PENDING_DO_WEST) PENDING_DO_WEST,
    ABS(PENDING_DO_EAST_Q.PENDING_DO_EAST) PENDING_DO_EAST,
    ABS(PENDING_DO_NORTH_Q.PENDING_DO_NORTH) PENDING_DO_NORTH,
    ABS(PENDING_DO_SOUTH_Q.PENDING_DO_SOUTH) PENDING_DO_SOUTH,
    ABS(PENDING_DO_CS_Q.PENDING_DO_CS) PENDING_DO_CS,
    ABS(PENDING_DO_BPR_Q.PENDING_DO_BPR) PENDING_DO_BPR,
    ABS(PENDING_DO_ENP_Q.PENDING_DO_ENP) PENDING_DO_ENP,
    ABS(PENDING_DO_CE_Q.PENDING_DO_CE) PENDING_DO_CE, ABS(ROLLSP.ROLL_OSP) AS ROLL_OSP
FROM
(
    SELECT
        ROUND(SUM(NVL(EOP_BTD,0)),0) EOP_BTD,
        ROUND(SUM(NVL(EOP_BTR,0)),0) EOP_BTR,
        ROUND(SUM(NVL(EOP_FG_QTY,0)),0) EOP_FG_QTY,
         MAX(
(
    SELECT NVL(ROUND(SUM(LOM_MS_GROSS_CAL/1000),0),0)
    FROM dashboard_production
    WHERE
    (
         LOM_CD_STATUS IN ('WB','WE','WI')
      OR LOM_CD_STATUS LIKE '%C'
      OR LOM_CD_STATUS LIKE '%P'
      OR LOM_CD_STATUS LIKE '%Q'
    )
    AND (LOM_ID_ORDER_CUS, LOM_ID_ORD_ITEM_CUS) IN
    (
        SELECT ENC_ID_ORDER, ENC_NO_ITEM
        FROM dashboard_orders
        WHERE ENC_ST_ORDER = 'A'
        AND ENC_DT_ORD_CREATE > (SYSDATE -365)
    )
)
) AS TOTAL_LNK_QTY,
        ROUND(SUM(NVL(EOP_SIGNOF_QTY,0)),0) EOP_SIGNOF_QTY,
        ROUND(SUM(NVL(EOP_VDI_GRN,0)),0) GRNCOMP_QTY,
        ROUND(
       NVL(
            (SUM(NVL(EOP_VDI_GRN,0))
             / NULLIF(SUM(NVL(EOP_SIGNOF_QTY,0)),0)
            ) * 100,
       0)
     ,0) AS GRNCOMP_PER
        FROM dashboard_progress,
         dashboard_orders
    WHERE EOP_CD_EPA = ENC_CD_EPA
      AND EOP_ID_ORDER = ENC_ID_ORDER
      AND EOP_NO_ITEM = ENC_NO_ITEM
      AND ENC_DT_ORD_CREATE > SYSDATE - 365
      AND ENC_ST_ORDER = 'A'
      AND EOP_CD_EPA = '0780'
      
) M
CROSS JOIN
(
    -- Segment-based sums
    SELECT
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS BPRTUBE_BTD,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS BPRTUBE_BTP,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS CETUBE_BTD,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS CETUBE_BTP,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS CSTUBE_BTD,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS CSTUBE_BTP,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS EPTUBE_BTD,
        ROUND(SUM(CASE WHEN EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS EPTUBE_BTP,
        -- Zone-based sums
        ROUND(SUM(CASE WHEN EOP_ZONE = 'API' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS API_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'API' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS API_BTP,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'East' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS EAST_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'East' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS EAST_BTP,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'North' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS NORTH_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'North' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS NORTH_BTP,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'South' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS SOUTH_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'South' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS SOUTH_BTP,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'West' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS WEST_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'West' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS WEST_BTP,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'Export' THEN NVL(EOP_BTD,0) ELSE 0 END),0) AS EXPORT_BTD,
        ROUND(SUM(CASE WHEN EOP_ZONE = 'Export' THEN NVL(EOP_BTR,0) ELSE 0 END),0) AS EXPORT_BTP
    FROM dashboard_progress
) S
CROSS JOIN
(
    -- Aggregations from dashboard_production
    SELECT
        NVL(ROUND(SUM(CASE WHEN LP.LOM_CD_STATUS IN (SELECT DISTINCT  CD_DESC
            FROM v_codes
            WHERE cd_type = 'TB040'
            AND CD_DESC1 IN ('FG STOCK')) THEN LP.LOM_MS_GROSS_CAL ELSE 0 END)/1000,0),0) AS TOTAL_STK_CALC,
        NVL(ROUND(SUM(CASE WHEN LP.LOM_ID_ORDER_CUS IS NOT NULL AND TRIM(LP.LOM_ID_ORDER_CUS) <> '0' AND LP.LOM_CD_STATUS IN (SELECT CD_DESC
            FROM v_codes
            WHERE cd_type = 'TB040'
            AND CD_DESC1 IN ('FG STOCK')) THEN LP.LOM_MS_GROSS_CAL ELSE 0 END)/1000,0),0) AS TOTAL_LINK_STK_CALC,
        NVL(ROUND(SUM(CASE WHEN  LP.LOM_CD_STATUS = '8Q' THEN LP.LOM_MS_GROSS_CAL ELSE 0 END)/1000,0),0) AS TOTAL_HOLD_CALC
    FROM dashboard_production LP
) P
CROSS JOIN
(
    -- Aggregations from dashboard_orders for Vertical and Zone counts
    SELECT
        -- VERTICAL_BP
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERTICAL_BP_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERTICAL_BP_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERTICAL_BP_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Branded Products & Retail' THEN 1 ELSE 0 END),0) AS VERTICAL_BP_GTOTAL_CALC,
        -- VERTICAL_CE
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Commercial & Exports' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERTICAL_CE_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Commercial & Exports' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERTICAL_CE_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Commercial & Exports' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERTICAL_CE_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Commercial & Exports' THEN 1 ELSE 0 END),0) AS VERTICAL_CE_GTOTAL_CALC,
        -- VERTICAL_CS
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERTICAL_CS_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERTICAL_CS_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERTICAL_CS_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Construction and Solution' THEN 1 ELSE 0 END),0) AS VERTICAL_CS_GTOTAL_CALC,
        -- VERTICAL_EP
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERTICAL_EP_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERTICAL_EP_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERTICAL_EP_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT = 'Engineering & Packaging - Tubes' THEN 1 ELSE 0 END),0) AS VERTICAL_EP_GTOTAL_CALC,
        -- VERTICAL_TOTAL
        ROUND(SUM(CASE WHEN ENC_SEGMENT IN ('Branded Products & Retail', 'Commercial & Exports', 'Construction and Solution', 'Engineering & Packaging - Tubes') AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERTICAL_TOTAL_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_SEGMENT IN ('Branded Products & Retail', 'Commercial & Exports', 'Construction and Solution', 'Engineering & Packaging - Tubes') AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERTICAL_TOTAL_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT IN ('Branded Products & Retail', 'Commercial & Exports', 'Construction and Solution', 'Engineering & Packaging - Tubes') AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERTICAL_TOTAL_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_SEGMENT IN ('Branded Products & Retail', 'Commercial & Exports', 'Construction and Solution', 'Engineering & Packaging - Tubes') THEN 1 ELSE 0 END),0) AS VERTICAL_TOTAL_GTOTAL_CALC,
        -- ZONE_API
        ROUND(SUM(CASE WHEN ENC_ZONE = 'API' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_API_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'API' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_API_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'API' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_API_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'API' THEN 1 ELSE 0 END),0) AS ZONE_API_GTOTAL_CALC,
        -- ZONE_EAST
        ROUND(SUM(CASE WHEN ENC_ZONE = 'East' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_EAST_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'East' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_EAST_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'East' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_EAST_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'East' THEN 1 ELSE 0 END),0) AS ZONE_EAST_GTOTAL_CALC,
        -- ZONE_ETO
        ROUND(SUM(CASE WHEN ENC_ZONE = 'ETO' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_ETO_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'ETO' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_ETO_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'ETO' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_ETO_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'ETO' THEN 1 ELSE 0 END),0) AS ZONE_ETO_GTOTAL_CALC,
        -- ZONE_NORTH
        ROUND(SUM(CASE WHEN ENC_ZONE = 'North' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_NORTH_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'North' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_NORTH_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'North' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_NORTH_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'North' THEN 1 ELSE 0 END),0) AS ZONE_NORTH_GTOTAL_CALC,
        -- ZONE_SOUTH
        ROUND(SUM(CASE WHEN ENC_ZONE = 'South' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_SOUTH_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'South' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_SOUTH_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'South' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_SOUTH_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'South' THEN 1 ELSE 0 END),0) AS ZONE_SOUTH_GTOTAL_CALC,
        -- ZONE_WEST
        ROUND(SUM(CASE WHEN ENC_ZONE = 'West' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_WEST_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'West' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_WEST_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'West' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_WEST_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'West' THEN 1 ELSE 0 END),0) AS ZONE_WEST_GTOTAL_CALC,
        -- ZONE_EXPORT
        ROUND(SUM(CASE WHEN ENC_ZONE = 'Export' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_EXPORT_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'Export' AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_EXPORT_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'Export' AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_EXPORT_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE = 'Export' THEN 1 ELSE 0 END),0) AS ZONE_EXPORT_GTOTAL_CALC,
        -- ZONE_TOTAL
        ROUND(SUM(CASE WHEN ENC_ZONE IN ('API', 'East', 'ETO', 'North', 'South', 'West', 'Export') AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS ZONE_TOTAL_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN ENC_ZONE IN ('API', 'East', 'ETO', 'North', 'South', 'West', 'Export') AND (SYSDATE - ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS ZONE_TOTAL_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE IN ('API', 'East', 'ETO', 'North', 'South', 'West', 'Export') AND (SYSDATE - ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS ZONE_TOTAL_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN ENC_ZONE IN ('API', 'East', 'ETO', 'North', 'South', 'West', 'Export') THEN 1 ELSE 0 END),0) AS ZONE_TOTAL_GTOTAL_CALC
    FROM dashboard_orders
        WHERE ENC_DT_ORD_CREATE > (SYSDATE -365)
    AND (ENC_ID_ORDER,ENC_NO_ITEM) IN (
      SELECT DISTINCT LOM_ID_ORDER_CUS,LOM_ID_ORD_ITEM_CUS FROM dashboard_production
    WHERE LOM_CD_STATUS NOT IN ('WF')
    AND LOM_CD_STATUS IN (
    SELECT CD_DESC
            FROM v_codes
            WHERE cd_type = 'TB040'
            AND CD_DESC1 IN ('FG STOCK')
    )
)
)O
CROSS JOIN
(
    -- Aggregations for Unlinked Stock
    SELECT
        -- VERT_UNLSTCK_API
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'API' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_API_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'API' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_API_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'API' AND (SYSDATE - e.ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_API_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'API' THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_API_GTOTAL_CALC,
        -- VERT_UNLSTCK_BPRS
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_BPRS_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_BPRS_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Branded Products & Retail' AND (SYSDATE - e.ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_BPRS_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Branded Products & Retail' THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_BPRS_GTOTAL_CALC,
        -- VERT_UNLSTCK_CS
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_CS_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_CS_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Construction and Solution' AND (SYSDATE - e.ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_CS_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_SEGMENT = 'Construction and Solution' THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_CS_GTOTAL_CALC,
        -- VERT_UNLSTCK_EXPORT
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'Export' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_EXPORT_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'Export' AND (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_EXPORT_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'Export' AND (SYSDATE - e.ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_EXPORT_PHIGHAGE_CALC,
        ROUND(SUM(CASE WHEN e.ENC_ZONE = 'Export' THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_EXPORT_GTOTAL_CALC,
        -- VERT_UNLSTCK_TOTAL
        ROUND(SUM(CASE WHEN (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 1 AND 53 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_TOTAL_BELOW_P_AGE,
        ROUND(SUM(CASE WHEN (SYSDATE - e.ENC_DT_ORD_CREATE) BETWEEN 53 AND 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_TOTAL_HIGHAGE_CALC,
        ROUND(SUM(CASE WHEN (SYSDATE - e.ENC_DT_ORD_CREATE) > 100 THEN 1 ELSE 0 END),0) AS VERT_UNLSTCK_TOTAL_PHIGHAGE_CALC,
        ROUND(SUM(1),0) AS VERT_UNLSTCK_TOTAL_GTOTAL_CALC -- Total count of all qualified unlinked orders
    FROM dashboard_orders e
    JOIN (
        -- Subquery to find distinct (order, item) pairs for unlinked stock
        SELECT DISTINCT bp.TBP_ID_ORDER_NO, bp.TBP_ITEM_NO
        FROM V_BARE_PDO bp
        JOIN dashboard_production lp ON bp.TBP_BATCH_NO = lp.LOM_ID_BATCH
        WHERE bp.TBP_CD_PROC = '1'
          AND lp.LOM_CD_STATUS = 'WF'
    ) UNLK_STK_Q ON e.ENC_ID_ORDER = UNLK_STK_Q.TBP_ID_ORDER_NO
                             AND e.ENC_NO_ITEM = UNLK_STK_Q.TBP_ITEM_NO
) U
CROSS JOIN
(
    -- Vertical 3
    SELECT
        -- VERT_BPR
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS VERT_BPR_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_BPR_GRC,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS VERT_BPR_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_BPR_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Branded Products & Retail' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS VERT_BPR_GAP,
        -- VERT_CE
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CE_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CE_GRC,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS VERT_CE_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CE_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Commercial & Exports' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS VERT_CE_GAP,
        -- VERT_CS
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CS_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CS_GRC,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS VERT_CS_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_CS_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Construction and Solution' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS VERT_CS_GAP,
        -- VERT_EP
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS VERT_EP_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_EP_GRC,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS VERT_EP_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_EP_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT = 'Engineering & Packaging - Tubes' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS VERT_EP_GAP,
        -- VERT_TOTAL
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT IN ('Engineering & Packaging - Tubes','Construction and Solution','Commercial & Exports','Branded Products & Retail') THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS VERT_TOTAL_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT IN ('Engineering & Packaging - Tubes','Construction and Solution','Commercial & Exports','Branded Products & Retail')  THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_TOTAL_GRC,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT IN ('Engineering & Packaging - Tubes','Construction and Solution','Commercial & Exports','Branded Products & Retail')  THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS VERT_TOTAL_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT IN ('Engineering & Packaging - Tubes','Construction and Solution','Commercial & Exports','Branded Products & Retail')  THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS VERT_TOTAL_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_SEGEMENT IN ('Engineering & Packaging - Tubes','Construction and Solution','Commercial & Exports','Branded Products & Retail')  THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS VERT_TOTAL_GAP
    FROM dashboard_progress e
) V
CROSS JOIN
(
    -- ZONE 3
    SELECT
       -----API
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'API' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_API_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'API' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_API_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'API' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_API_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'API' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_API_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'API' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_API_GAP,
        --EAST
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'East' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EAST_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'East' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EAST_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'East' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_EAST_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'East' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EAST_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'East' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_EAST_GAP,
        -- NORTH
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'North' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_NORTH_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'North' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_NORTH_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'North' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_NORTH_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'North' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_NORTH_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'North' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_NORTH_GAP,
        -- SOUTH
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'South' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_SOUTH_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'South' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_SOUTH_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'South' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_SOUTH_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'South' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_SOUTH_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'South' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_SOUTH_GAP,
         -- WEST
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'West' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_WEST_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'West' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_WEST_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'West' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_WEST_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'West' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_WEST_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'West' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_WEST_GAP,
         -- EXPORT
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'Export' THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EXPORT_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'Export' THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EXPORT_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'Export' THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_EXPORT_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'Export' THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_EXPORT_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE =  'Export' THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_EXPORT_GAP,
        --GRAND TOTAL
        ROUND(SUM(CASE WHEN e.EOP_ZONE IN('East','North','South','West','API','Export') THEN NVL(EOP_SIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_GTOTAL_SIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE IN('East','North','South','West','API','Export') THEN NVL(EOP_SIGNOF_QTY,0) + NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_GTOTAL_GRC,
        ROUND(SUM(CASE WHEN e.EOP_ZONE IN('East','North','South','West','API','Export') THEN NVL(EOP_VDI_GRN,0) ELSE 0 END),0) AS ZONE_GTOTAL_SUMSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE IN('East','North','South','West','API','Export') THEN NVL(EOP_NSIGNOF_QTY,0) ELSE 0 END),0) AS ZONE_GTOTAL_NONSIGNOFF,
        ROUND(SUM(CASE WHEN e.EOP_ZONE IN('East','North','South','West','API','Export') THEN NVL(EOP_GRN_GAP,0) ELSE 0 END),0) AS ZONE_GTOTAL_GAP
    FROM dashboard_progress e
) Z
CROSS JOIN
(
    -- Subquery for ROLLING_MTD (from original QUERY 2)
    SELECT NVL(ROUND(SUM((a.tbp_weight) / 1000),0), 0) AS ROLLING_MTD
    FROM v_bare_pdo a, dashboard_production b
    WHERE a.tbp_plant_cd = '0780'
      AND a.TBP_BATCH_NO = b.LOM_ID_BATCH
      AND a.TBP_CD_PROC = '1'
      AND a.TBP_BATCH_PROC_NO = (
          SELECT MAX(t1.TBP_BATCH_PROC_NO)
          FROM v_bare_pdo t1
          WHERE a.tbp_batch_no = t1.tbp_batch_no
            AND a.tbp_cd_proc = t1.tbp_cd_proc
      )
      AND a.TBP_PROD_DATE BETWEEN TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)) + 1) AND (SYSDATE - 1)
) RLMTD
CROSS JOIN
(
    -- Subquery for PRODUCTION_MTD (from original QUERY 3)
    SELECT NVL(ROUND(SUM((a.tbp_weight) / 1000),0), 0) AS PRODUCTION_MTD
    FROM v_bare_pdo a, dashboard_production b
    WHERE a.tbp_plant_cd = '0780'
      AND a.TBP_BATCH_NO = b.LOM_ID_BATCH
      AND a.TBP_CD_PROC IN ('8','E','H')
      AND a.TBP_RESULT <> 'NOT OK'
      AND a.TBP_BATCH_PROC_NO = (
          SELECT MAX(t1.TBP_BATCH_PROC_NO)
          FROM v_bare_pdo t1
          WHERE a.tbp_batch_no = t1.tbp_batch_no
            AND a.tbp_cd_proc = t1.tbp_cd_proc
      )
      AND a.TBP_PROD_DATE BETWEEN TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)) + 1) AND (SYSDATE - 1)
) PRMTD
CROSS JOIN
(
    --  ROLLING_OSP from V_CODES
    SELECT TO_NUMBER(CD_VALUE) AS ROLL_OSP
    FROM V_CODES
    WHERE CD_TYPE = 'TB068'
      AND CD_DESC = 'RollingOSP'
) ROLLSP
CROSS JOIN
(
    -- PRODUCTION_OSP from V_CODES
    SELECT TO_NUMBER(CD_VALUE) AS PRD_OSP
    FROM V_CODES
    WHERE CD_TYPE = 'TB068'
      AND CD_DESC = 'ProductionOSP'
) PRLMTD
CROSS JOIN
(
    -- New subquery for EOP_FG_QTY sums
    SELECT
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BPR_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BPR_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BPR_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BPR_TOTAL,
--
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CE_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CE_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CE_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CE_TOTAL,
--
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CS_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CS_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CS_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_CS_TOTAL,
--
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_EP_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_EP_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_EP_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_EP_TOTAL,
--
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BLANK_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BLANK_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BLANK_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL THEN LDP.EOP_FG_QTY ELSE 0 END) AS VER_EOP_BLANK_TOTAL
    FROM
        dashboard_progress LDP
    INNER JOIN
        dashboard_orders EPA
    ON
            LDP.EOP_CD_EPA = EPA.ENC_CD_EPA
        AND LDP.EOP_ID_ORDER = EPA.ENC_ID_ORDER
        AND LDP.EOP_NO_ITEM = EPA.ENC_NO_ITEM
    WHERE
        EPA.ENC_ST_ORDER = 'A'
        AND EPA.ENC_DT_ORD_CREATE > SYSDATE - 365
        AND EPA.ENC_CD_EPA = '0780'
) FG
CROSS JOIN
(
    -- New subquery for EOP_WIP_QTY sums
    SELECT
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BPR_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BPR_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BPR_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Branded Products & Retail' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BPR_TOTAL,
----
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CE_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CE_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CE_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Commercial & Exports' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CE_TOTAL,
-----
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CS_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CS_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CS_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Construction and Solution' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_CS_TOTAL,
-----
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_EP_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_EP_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_EP_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT = 'Engineering & Packaging - Tubes' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_EP_TOTAL,
----
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND = 'P' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BLANK_P,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND = 'T' THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BLANK_T,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL AND EPA.ENC_FRT_IND IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BLANK_N,
        SUM(CASE WHEN EPA.ENC_SEGMENT IS NULL THEN LDP.EOP_WIP_QTY ELSE 0 END) AS P_DO_BLANK_TOTAL
    FROM
        dashboard_progress LDP
    INNER JOIN
        dashboard_orders EPA
    ON
            LDP.EOP_CD_EPA = EPA.ENC_CD_EPA
        AND LDP.EOP_ID_ORDER = EPA.ENC_ID_ORDER
        AND LDP.EOP_NO_ITEM = EPA.ENC_NO_ITEM
    WHERE
        EPA.ENC_ST_ORDER = 'A'
        AND EPA.ENC_DT_ORD_CREATE > SYSDATE - 365
        AND EPA.ENC_CD_EPA = '0780'
)PDO
CROSS JOIN
(
    --------------ZONES-------------------
    SELECT NVL(ROUND(SUM((a.tbp_weight) / 1000),0), 0) AS MTD_4_API
    FROM v_bare_pdo a, dashboard_production b , dashboard_progress C
    WHERE a.tbp_plant_cd = '0780'
      AND a.TBP_BATCH_NO = b.LOM_ID_BATCH
      AND a.TBP_CD_PROC = '1'
      AND a.TBP_BATCH_PROC_NO = (
          SELECT MAX(t1.TBP_BATCH_PROC_NO)
          FROM v_bare_pdo t1
          WHERE a.tbp_batch_no = t1.tbp_batch_no
            AND a.tbp_cd_proc = t1.tbp_cd_proc
      )
      AND a.TBP_PROD_DATE BETWEEN TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)) + 1) AND (SYSDATE - 1)
      AND c.EOP_ID_ORDER = b.LOM_ID_ORDER_CUS
      AND c.EOP_NO_ITEM = b.LOM_ID_ORD_ITEM_CUS
      AND C.EOP_CD_EPA = b.LOM_CD_EPA
      AND c.EOP_ZONE = 'API'
) MTD_4_API_Q
