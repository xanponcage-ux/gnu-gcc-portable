+export const updateSignoff = async (req: Request, res: Response) => {
+  try {
+    const result = await writeSignoff(req.body);
+    if (!result.rowsAffected) return res.status(404).json({message:"Order item not found."});
+    return res.status(200).json({updated:result.rowsAffected});
+  } catch(e) { return res.status(400).json({message:e instanceof TypeError ? e.message : "Sign-off update failed."}); }
+};
