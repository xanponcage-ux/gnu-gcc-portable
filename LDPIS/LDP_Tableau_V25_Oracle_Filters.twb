          </named-connection>
        </named-connections>
        <relation connection="oracle.ldp_live_v13" name="LDP Dashboard Query" type="text"><![CDATA[WITH filter_args AS (SELECT NULLIF(<Parameters.Parameter 1>, '(All)') AS MILL_VALUE, NULLIF(<Parameters.Parameter 2>, '(All)') AS AURT, NULLIF(<Parameters.Parameter 3>, '(All)') AS SEGEMENT, NULLIF(<Parameters.Parameter 4>, '(All)') AS CUSTNAME, NULLIF(<Parameters.Parameter 5>, '(All)') AS ZONES, NULLIF(<Parameters.Parameter 6>, '(All)') AS IND_FRT, NULLIF(<Parameters.Parameter 7>, '(All)') AS IND FROM dual),
selected_orders AS (SELECT e.* FROM V_END_CUST_ORD_EPA e CROSS JOIN filter_args f WHERE ENC_CD_EPA='0780' AND (
            (f.MILL_VALUE = 1 AND (ENC_ODIA,ENC_IDIA) IN (('273.1','0'), ('273','0'), ('323.9','0'), ('355.6','0'), ('355.5','0'), ('406.4','0'), ('457','0'), ('457.2','0'), ('508','0'), ('558.8','0'), ('559','0'), ('610','0'), ('200','200'), ('250','250'), ('300','300'), ('400','400'), ('250','150'), ('300','200'), ('400','200')))
         OR (f.MILL_VALUE = 2 AND (ENC_ODIA,ENC_IDIA) IN (('72','72'), ('80','80'), ('91.5','91.5'), ('90','90'), ('100','100'), ('132','132'), ('150','150'), ('200','100'), ('150','110'), ('88.9','0'), ('114.3','0'), ('127','0'), ('139.7','0'), ('165.1','0'), ('165.2','0'), ('168.3','0'), ('219.1','0')))
         OR (f.MILL_VALUE IS NULL)
      )
      AND (f.SEGEMENT IS NULL OR NVL(ENC_SEGMENT, '(Blank)') = f.SEGEMENT)
      AND (f.CUSTNAME IS NULL OR NVL(ENC_CUST_NAME, '(Blank)') = f.CUSTNAME)
      AND (f.IND_FRT IS NULL OR NVL(ENC_FRT_IND, '(Blank)') = f.IND_FRT)
      AND (f.ZONES IS NULL OR NVL(ENC_ZONE, '(Blank)') = f.ZONES)
      AND (f.IND IS NULL OR (
            (f.IND = 'OPEN' AND ENC_BILING_BLOCK IS NULL AND ENC_DELV_BLOCK IS NULL)
            OR
            (f.IND = 'BLOCKED' AND (ENC_BILING_BLOCK IS NOT NULL OR ENC_DELV_BLOCK IS NOT NULL))
        )) AND (f.AURT IS NULL OR NVL(ENC_ORDER_TYPE, '(Blank)') = f.AURT)),
dashboard_orders AS (SELECT t.* FROM V_END_CUST_ORD_EPA t CROSS JOIN filter_args f WHERE (f.MILL_VALUE IS NULL AND f.AURT IS NULL AND f.SEGEMENT IS NULL AND f.CUSTNAME IS NULL AND f.ZONES IS NULL AND f.IND_FRT IS NULL AND f.IND IS NULL) OR EXISTS (SELECT 1 FROM selected_orders e WHERE e.ENC_ID_ORDER=t.ENC_ID_ORDER AND e.ENC_NO_ITEM=t.ENC_NO_ITEM AND e.ENC_CD_EPA=t.ENC_CD_EPA)),
dashboard_progress AS (SELECT t.* FROM V_LDP_ORDER_PROG t CROSS JOIN filter_args f WHERE (f.MILL_VALUE IS NULL AND f.AURT IS NULL AND f.SEGEMENT IS NULL AND f.CUSTNAME IS NULL AND f.ZONES IS NULL AND f.IND_FRT IS NULL AND f.IND IS NULL) OR EXISTS (SELECT 1 FROM selected_orders e WHERE e.ENC_ID_ORDER=t.EOP_ID_ORDER AND e.ENC_NO_ITEM=t.EOP_NO_ITEM AND e.ENC_CD_EPA=t.EOP_CD_EPA)),
dashboard_production AS (SELECT t.* FROM V_LDP_PRODN t CROSS JOIN filter_args f WHERE (f.MILL_VALUE IS NULL AND f.AURT IS NULL AND f.SEGEMENT IS NULL AND f.CUSTNAME IS NULL AND f.ZONES IS NULL AND f.IND_FRT IS NULL AND f.IND IS NULL) OR EXISTS (SELECT 1 FROM selected_orders e WHERE e.ENC_ID_ORDER=t.LOM_ID_ORDER_CUS AND e.ENC_NO_ITEM=t.LOM_ID_ORD_ITEM_CUS)),
dashboard_pending AS (SELECT t.* FROM LDPDBA.MV_PENDING_DO t CROSS JOIN filter_args f WHERE (f.MILL_VALUE IS NULL AND f.AURT IS NULL AND f.SEGEMENT IS NULL AND f.CUSTNAME IS NULL AND f.ZONES IS NULL AND f.IND_FRT IS NULL AND f.IND IS NULL) OR EXISTS (SELECT 1 FROM selected_orders e WHERE e.ENC_ID_ORDER=t.EOP_ID_ORDER AND e.ENC_NO_ITEM=t.EOP_NO_ITEM)), base AS (
SELECT
    ABS(M.EOP_BTD) AS BTD,
    ABS(M.EOP_BTR) AS BTR,
    ABS(PENDINGDO.PENDING_DO) AS PENDING_DO,
    ABS(NVL(M.EOP_FG_QTY,0)) AS TOTAL_LNK_QTY,
--    ABS(M.EOP_FG_QTY) AS TOTAL_STK_CALC,
    ABS(P.TOTAL_STK_CALC) AS TOTAL_STK_CALC,
    ABS(NVL(M.EOP_FG_QTY,0)) AS TOTAL_LINK_STK_CALC,
    ABS((P.TOTAL_STK_CALC - P.TOTAL_LINK_STK_CALC)) AS TOTAL_UNLINK_STK_CALC,
    ABS(P.TOTAL_HOLD_CALC) AS TOTAL_HOLD_CALC,
    CASE
        WHEN M.EOP_FG_QTY = 0 THEN 0
        ELSE ROUND( (P.TOTAL_HOLD_CALC / M.EOP_FG_QTY) * 100 , 0)
    END AS TOTAL_HOLD_PER,
    ABS(M.EOP_SIGNOF_QTY) AS EOP_SIGNOF_QTY,
    ABS(M.GRNCOMP_QTY) AS GRNCOMP_QTY,
    ABS(M.GRNCOMP_PER) AS GRNCOMP_PER,
    ABS(RLMTD.ROLLING_MTD) AS ROLLING_MTD,
    ABS(ROLLSP.ROLL_OSP) AS ROLLING_OSP,
    ROUND(((RLMTD.ROLLING_MTD / NULLIF(ROLLSP.ROLL_OSP, 0)) * 100), 0) AS ROLLCOMP_PER,
    abs(PRMTD.PRODUCTION_MTD) AS PRODUCTION_OSP,
    abs(PRLMTD.PRD_OSP) AS PRODUCTION_MTD,
    ROUND(((PRMTD.PRODUCTION_MTD / NULLIF(PRLMTD.PRD_OSP, 0)) * 100), 0) AS PRODUCTION_PER,
    --Segments S
    ABS(S.BPRTUBE_BTD) AS BPRTUBE_BTD,
    ABS(S.BPRTUBE_BTP) AS BPRTUBE_BTP,
    ABS(S.CETUBE_BTD) AS CETUBE_BTD,
    ABS(S.CETUBE_BTP) AS CETUBE_BTP,
    ABS(S.CSTUBE_BTD) AS CSTUBE_BTD,
    ABS(S.CSTUBE_BTP) AS CSTUBE_BTP,
    ABS(S.EPTUBE_BTD) AS EPTUBE_BTD,
    ABS(S.EPTUBE_BTP) AS EPTUBE_BTP,
    -- Zones
    ABS(S.API_BTD) AS API_BTD,
    ABS(S.API_BTP) AS API_BTP,
    ABS(S.EAST_BTD) AS EAST_BTD,
    ABS(S.EAST_BTP) AS EAST_BTP,
    ABS(S.NORTH_BTD) AS NORTH_BTD,
    ABS(S.NORTH_BTP) AS NORTH_BTP,
    ABS(S.SOUTH_BTD) AS SOUTH_BTD,
    ABS(S.SOUTH_BTP) AS SOUTH_BTP,
    ABS(S.WEST_BTD) AS WEST_BTD,
    ABS(S.WEST_BTP) AS WEST_BTP,
    ABS(S.EXPORT_BTD) AS EXPORT_BTD,
    ABS(S.EXPORT_BTP) AS EXPORT_BTP,
    ----------------Vertical---------------
    ABS(O.VERTICAL_BP_BELOW_P_AGE) AS VERTICAL_BP_BELOW_AGE,
    ABS(O.VERTICAL_BP_HIGHAGE_CALC) AS VERTICAL_BP_HIGHAGE,
    ABS(O.VERTICAL_BP_PHIGHAGE_CALC) AS VERTICAL_BP_PHIGHAGE,
    ABS(O.VERTICAL_BP_GTOTAL_CALC) AS VERTICAL_BP_GTOTAL,
    ABS(O.VERTICAL_CE_BELOW_P_AGE) AS VERTICAL_CE_BELOW_AGE,
    ABS(O.VERTICAL_CE_HIGHAGE_CALC) AS VERTICAL_CE_HIGHAGE,
    ABS(O.VERTICAL_CE_PHIGHAGE_CALC) AS VERTICAL_CE_PHIGHAGE,
    ABS(O.VERTICAL_CE_GTOTAL_CALC) AS VERTICAL_CE_GTOTAL,
    ABS(O.VERTICAL_CS_BELOW_P_AGE) AS VERTICAL_CS_BELOW_AGE,
    ABS(O.VERTICAL_CS_HIGHAGE_CALC) AS VERTICAL_CS_HIGHAGE,
    ABS(O.VERTICAL_CS_PHIGHAGE_CALC) AS VERTICAL_CS_PHIGHAGE,
    ABS(O.VERTICAL_CS_GTOTAL_CALC) AS VERTICAL_CS_GTOTAL,
    ABS(O.VERTICAL_EP_BELOW_P_AGE) AS VERTICAL_EP_BELOW_AGE,
    ABS(O.VERTICAL_EP_HIGHAGE_CALC) AS VERTICAL_EP_HIGHAGE,
    ABS(O.VERTICAL_EP_PHIGHAGE_CALC) AS VERTICAL_EP_PHIGHAGE,
    ABS(O.VERTICAL_EP_GTOTAL_CALC) AS VERTICAL_EP_GTOTAL,
    ABS(O.VERTICAL_TOTAL_BELOW_P_AGE) AS VERTICAL_TOTAL_BELOW_AGE,
    ABS(O.VERTICAL_TOTAL_HIGHAGE_CALC) AS VERTICAL_TOTAL_HIGHAGE,
    ABS(O.VERTICAL_TOTAL_PHIGHAGE_CALC) AS VERTICAL_TOTAL_PHIGHAGE,
    ABS(O.VERTICAL_TOTAL_GTOTAL_CALC) AS VERTICAL_TOTAL_GTOTAL,
    ---------ZONE -------------------
    ABS(O.ZONE_API_BELOW_P_AGE) AS ZONE_API_BELOW_AGE,
    ABS(O.ZONE_API_HIGHAGE_CALC) AS ZONE_API_HIGHAGE,
    ABS(O.ZONE_API_PHIGHAGE_CALC) AS ZONE_API_PHIGHAGE,
    ABS(O.ZONE_API_GTOTAL_CALC) AS ZONE_API_GTOTAL,
    ABS(O.ZONE_EAST_BELOW_P_AGE) AS ZONE_EAST_BELOW_AGE,
    ABS(O.ZONE_EAST_HIGHAGE_CALC) AS ZONE_EAST_HIGHAGE,
    ABS(O.ZONE_EAST_PHIGHAGE_CALC) AS ZONE_EAST_PHIGHAGE,
    ABS(O.ZONE_EAST_GTOTAL_CALC) AS ZONE_EAST_GTOTAL,
    ABS(O.ZONE_ETO_BELOW_P_AGE) AS ZONE_ETO_BELOW_AGE,
    ABS(O.ZONE_ETO_HIGHAGE_CALC) AS ZONE_ETO_HIGHAGE,
    ABS(O.ZONE_ETO_PHIGHAGE_CALC) AS ZONE_ETO_PHIGHAGE,
    ABS(O.ZONE_ETO_GTOTAL_CALC) AS ZONE_ETO_GTOTAL,
    ABS(O.ZONE_NORTH_BELOW_P_AGE) AS ZONE_NORTH_BELOW_AGE,
    ABS(O.ZONE_NORTH_HIGHAGE_CALC) AS ZONE_NORTH_HIGHAGE,
    ABS(O.ZONE_NORTH_PHIGHAGE_CALC) AS ZONE_NORTH_PHIGHAGE,
    ABS(O.ZONE_NORTH_GTOTAL_CALC) AS ZONE_NORTH_GTOTAL,
    ABS(O.ZONE_SOUTH_BELOW_P_AGE) AS ZONE_SOUTH_BELOW_AGE,
    ABS(O.ZONE_SOUTH_HIGHAGE_CALC) AS ZONE_SOUTH_HIGHAGE,
    ABS(O.ZONE_SOUTH_PHIGHAGE_CALC) AS ZONE_SOUTH_PHIGHAGE,
    ABS(O.ZONE_SOUTH_GTOTAL_CALC) AS ZONE_SOUTH_GTOTAL,
    ABS(O.ZONE_WEST_BELOW_P_AGE) AS ZONE_WEST_BELOW_AGE,
    ABS(O.ZONE_WEST_HIGHAGE_CALC) AS ZONE_WEST_HIGHAGE,
    ABS(O.ZONE_WEST_PHIGHAGE_CALC) AS ZONE_WEST_PHIGHAGE,
    ABS(O.ZONE_WEST_GTOTAL_CALC) AS ZONE_WEST_GTOTAL,
    ABS(O.ZONE_EXPORT_BELOW_P_AGE) AS ZONE_EXPORT_BELOW_AGE,
    ABS(O.ZONE_EXPORT_HIGHAGE_CALC) AS ZONE_EXPORT_HIGHAGE,
    ABS(O.ZONE_EXPORT_PHIGHAGE_CALC) AS ZONE_EXPORT_PHIGHAGE,
    ABS(O.ZONE_EXPORT_GTOTAL_CALC) AS ZONE_EXPORT_GTOTAL,
    ABS(O.ZONE_TOTAL_BELOW_P_AGE) AS ZONE_TOTAL_BELOW_AGE,
    ABS(O.ZONE_TOTAL_HIGHAGE_CALC) AS ZONE_TOTAL_HIGHAGE,
    ABS(O.ZONE_TOTAL_PHIGHAGE_CALC) AS ZONE_TOTAL_PHIGHAGE,
    ABS(O.ZONE_TOTAL_GTOTAL_CALC) AS ZONE_TOTAL_GTOTAL,
    ----------------UNLINKED STOCK--------------
    ABS(U.VERT_UNLSTCK_API_BELOW_P_AGE) AS VERT_UNLSTCK_API_BELOW_AGE,
    ABS(U.VERT_UNLSTCK_API_HIGHAGE_CALC) AS VERT_UNLSTCK_API_HIGHAGE,
    ABS(U.VERT_UNLSTCK_API_PHIGHAGE_CALC) AS VERT_UNLSTCK_API_PHIGHAGE,
    ABS(U.VERT_UNLSTCK_API_GTOTAL_CALC) AS VERT_UNLSTCK_API_GTOTAL,
    ABS(U.VERT_UNLSTCK_BPRS_BELOW_P_AGE) AS VERT_UNLSTCK_BPRS_BELOW_AGE,
    ABS(U.VERT_UNLSTCK_BPRS_HIGHAGE_CALC) AS VERT_UNLSTCK_BPRS_HIGHAGE,
    ABS(U.VERT_UNLSTCK_BPRS_PHIGHAGE_CALC) AS VERT_UNLSTCK_BPRS_PHIGHAGE,
    ABS(U.VERT_UNLSTCK_BPRS_GTOTAL_CALC) AS VERT_UNLSTCK_BPRS_GTOTAL,
    ABS(U.VERT_UNLSTCK_CS_BELOW_P_AGE) AS VERT_UNLSTCK_CS_BELOW_AGE,
    ABS(U.VERT_UNLSTCK_CS_HIGHAGE_CALC) AS VERT_UNLSTCK_CS_HIGHAGE,
    ABS(U.VERT_UNLSTCK_CS_PHIGHAGE_CALC) AS VERT_UNLSTCK_CS_PHIGHAGE,
    ABS(U.VERT_UNLSTCK_CS_GTOTAL_CALC) AS VERT_UNLSTCK_CS_GTOTAL,
    ABS(U.VERT_UNLSTCK_EXPORT_BELOW_P_AGE) AS VERT_UNLSTCK_EXPORT_BELOW_AGE,
    ABS(U.VERT_UNLSTCK_EXPORT_HIGHAGE_CALC) AS VERT_UNLSTCK_EXPORT_HIGHAGE,
    ABS(U.VERT_UNLSTCK_EXPORT_PHIGHAGE_CALC) AS VERT_UNLSTCK_EXPORT_PHIGHAGE,
    ABS(U.VERT_UNLSTCK_EXPORT_GTOTAL_CALC) AS VERT_UNLSTCK_EXPORT_GTOTAL,
    ABS(U.VERT_UNLSTCK_TOTAL_BELOW_P_AGE) AS VERT_UNLSTCK_TOTAL_BELOW_AGE,
    ABS(U.VERT_UNLSTCK_TOTAL_HIGHAGE_CALC) AS VERT_UNLSTCK_TOTAL_HIGHAGE,
    ABS(U.VERT_UNLSTCK_TOTAL_PHIGHAGE_CALC) AS VERT_UNLSTCK_TOTAL_PHIGHAGE,
    ABS(U.VERT_UNLSTCK_TOTAL_GTOTAL_CALC) AS VERT_UNLSTCK_TOTAL_GTOTAL,
    -----------------------VERTICAL------------------------
    ABS(V.VERT_BPR_SIGNOFF) AS VERT_BPR_SIGNOFF,
    ABS(V.VERT_BPR_GRC) AS VERT_BPR_GRC,
    ABS(V.VERT_BPR_SUMSIGNOFF) AS VERT_BPR_SUMSIGNOFF,
    ABS(V.VERT_BPR_NONSIGNOFF) AS VERT_BPR_NONSIGNOFF,
    ABS(V.VERT_BPR_GAP) AS VERT_BPR_GAP,
    --
    ABS(V.VERT_CE_SIGNOFF) AS VERT_CE_SIGNOFF,
    ABS(V.VERT_CE_GRC) AS VERT_CE_GRC,
    ABS(V.VERT_CE_SUMSIGNOFF) AS VERT_CE_SUMSIGNOFF,
    ABS(V.VERT_CE_NONSIGNOFF) AS VERT_CE_NONSIGNOFF,
    ABS(V.VERT_CE_GAP) AS VERT_CE_GAP,
    --
    ABS(V.VERT_CS_SIGNOFF) AS VERT_CS_SIGNOFF,
    ABS(V.VERT_CS_GRC) AS VERT_CS_GRC,
    ABS(V.VERT_CS_SUMSIGNOFF) AS VERT_CS_SUMSIGNOFF,
    ABS(V.VERT_CS_NONSIGNOFF) AS VERT_CS_NONSIGNOFF,
    ABS(V.VERT_CS_GAP) AS VERT_CS_GAP,
    --
    ABS(V.VERT_EP_SIGNOFF) AS VERT_EP_SIGNOFF,
