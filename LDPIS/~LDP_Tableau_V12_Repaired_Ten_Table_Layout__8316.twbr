    S.EAST_BTP,
    S.NORTH_BTD,
    S.NORTH_BTP,
    S.SOUTH_BTD,
    S.SOUTH_BTP,
    S.WEST_BTD,
    S.WEST_BTP,
    S.EXPORT_BTD,
    S.EXPORT_BTP
FROM
(
    SELECT
        SUM(NVL(EOP_BTD,0)) EOP_BTD,
        SUM(NVL(EOP_BTP,0)) EOP_BTP,
        SUM(NVL(EOP_MILLSCH_QTY,0)) EOP_MILLSCH_QTY,
