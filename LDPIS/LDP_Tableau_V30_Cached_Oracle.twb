      <column datatype="integer" name="[Vertical]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Table Number] WHEN 4 THEN CASE [Row Number] WHEN 1 THEN 1 WHEN 2 THEN 3 WHEN 3 THEN 5 WHEN 4 THEN 7 WHEN 5 THEN 9 END WHEN 6 THEN CASE [Row Number] WHEN 1 THEN 1 WHEN 2 THEN 3 WHEN 3 THEN 5 WHEN 4 THEN 7 WHEN 5 THEN 9 END WHEN 8 THEN CASE [Row Number] WHEN 1 THEN 2 WHEN 2 THEN 4 WHEN 3 THEN 6 WHEN 4 THEN 8 WHEN 5 THEN 9 END WHEN 9 THEN CASE [Row Number] WHEN 1 THEN 1 WHEN 2 THEN 3 WHEN 3 THEN 5 WHEN 4 THEN 7 WHEN 5 THEN 9 END END"/>
        <aliases>
