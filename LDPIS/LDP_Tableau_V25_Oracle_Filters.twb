SELECT
ROUND(SUM(PENDING_DO/1000) ,0) PENDING_DO
FROM dashboard_pending
) PENDINGDO
CROSS JOIN
(
    SELECT
    ROUND(NVL(SUM(MPD.PENDING_DO/1000),0) ,0) AS PENDING_DO_API
    FROM dashboard_pending MPD
    WHERE (MPD.EOP_ID_ORDER, MPD.EOP_NO_ITEM) IN (
        SELECT ENC_ID_ORDER,ENC_NO_ITEM FROM dashboard_orders
        WHERE ENC_ST_ORDER = 'A' and
        ENC_DT_ORD_CREATE > (SYSDATE - 365)
        AND ENC_ZONE = 'API'
    )
) PENDING_DO_API_Q
