        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type="collection"><relation connection="oracle.ldp_live_v13" name="LDP Dashboard Query" type="text"><![CDATA[SELECT j."Table Number", j."Row Number", j."Column Number", j."Value",
       1 AS "Dashboard Link"
FROM JSON_TABLE(
  LDPDBA.LDP_DASH_CELLS_V30(TO_NCHAR(<[Parameters].[Parameter 1]>), TO_NCHAR(<[Parameters].[Parameter 2]>), TO_NCHAR(<[Parameters].[Parameter 3]>), TO_NCHAR(<[Parameters].[Parameter 4]>), TO_NCHAR(<[Parameters].[Parameter 5]>), TO_NCHAR(<[Parameters].[Parameter 6]>), TO_NCHAR(<[Parameters].[Parameter 7]>)),
  '$[*]' COLUMNS (
    "Table Number" NUMBER PATH '$.t',
    "Row Number" NUMBER PATH '$.r',
    "Column Number" NUMBER PATH '$.c',
    "Value" NUMBER PATH '$.v'
  )
) j]]></relation>
<relation connection="oracle.ldp_live_v13" name="LDP Filter Choices" type="text"><![CDATA[SELECT DISTINCT NVL(TO_NCHAR(ENC_ORDER_TYPE), N'(Blank)') AS ENC_ORDER_TYPE, NVL(TO_NCHAR(ENC_SEGMENT), N'(Blank)') AS ENC_SEGMENT, NVL(TO_NCHAR(ENC_CUST_NAME), N'(Blank)') AS ENC_CUST_NAME, NVL(TO_NCHAR(ENC_ZONE), N'(Blank)') AS ENC_ZONE, NVL(TO_NCHAR(ENC_FRT_IND), N'(Blank)') AS ENC_FRT_IND, CAST(NULL AS NUMBER) AS "Choice Link" FROM V_END_CUST_ORD_EPA WHERE ENC_CD_EPA = '0780' UNION ALL SELECT N'(All)', N'(All)', N'(All)', N'(All)', N'(All)', 1 FROM dual]]></relation></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
