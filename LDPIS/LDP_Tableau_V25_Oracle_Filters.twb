    ABS(V.VERT_TOTAL_GAP) AS VERT_TOTAL_GAP,
    ----------------ZONE----------------
    ABS(Z.ZONE_API_SIGNOFF) AS ZONE_API_SIGNOFF,
    ABS(Z.ZONE_API_GRC) AS ZONE_API_GRC,
